# Copy to .env.local for local dev. For GitHub Pages, set the same names
# as repository Actions/build env vars (or Vite env) before `npm run deploy`.
#
# Without these, the app falls back to localStorage-only learning (per browser).

VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
VITE_TEAM_WRITE_SECRET=YOUR_TEAM_WRITE_SECRET
